# ---- Database ----
# SQLite file (created and migrated automatically on start). The desktop app will point this at %APPDATA%.
DATABASE_URL=file:./pos.db
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# ---- Optional ----
NODE_ENV=development
PORT=4000
# Allowed frontend origins (development only; the desktop app does not use CORS).
CORS_ORIGINS=http://localhost:5173
JWT_EXPIRES_IN_SECONDS=43200
BCRYPT_ROUNDS=12
# Used for "today", daily grouping and the dashboard.
TIMEZONE=Africa/Kampala

# External barcode identification (identification data only; prices stay yours).
# openfoodfacts (free, no key) | upcitemdb | none
BARCODE_LOOKUP_PROVIDER=openfoodfacts
# Override the endpoint; "{barcode}" is replaced with the scanned code.
# BARCODE_LOOKUP_URL=https://world.openfoodfacts.org/api/v2/product/{barcode}.json
# BARCODE_LOOKUP_API_KEY=
BARCODE_LOOKUP_TIMEOUT_MS=3000

# ---- Only for `npm run seed:admin` (first administrator) ----
# ADMIN_EMAIL=owner@yourstore.com
# ADMIN_PASSWORD=use-a-strong-passphrase-12+chars
# ADMIN_NAME=Store Owner
# BRANCH_NAME=Main Branch

# ---- Email login approval (see README section 6a) ----
# Leave SMTP_HOST, EMAIL_FROM and PUBLIC_BASE_URL empty to run WITHOUT it: sign-in is then password only and the app says so.
# Set all three to turn it on (admins and managers must then approve each sign-in from an email).
# Public address of THIS backend, where the Approve / Reject links open (https in production). No trailing path.
PUBLIC_BASE_URL=
# Sender shown on the email, e.g. pos@yourshop.com or "Shop POS <pos@yourshop.com>"
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
# Both or neither. Keep these secret: they are only ever read by the backend.
SMTP_USER=
SMTP_PASS=
