    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "electron": "^42.11.15",
    "electron-builder": "^26.17.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Supermarket POS",
  "allowScripts": {
    "electron-winstaller": false
  }
