{
  "name": "supermarket-pos-desktop",
  "private": true,
  "version": "1.0.1",
  "description": "Electron shell for the Supermarket POS",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "light-my-request": "^6.6.0"
