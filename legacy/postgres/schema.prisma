generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  MANAGER
  CASHIER
  STOCK_OFFICER
  ACCOUNTANT
  AUDITOR
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  RETURN
  DAMAGED
  EXPIRED
  LOSS
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  OTHER
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PurchaseStatus {
  ORDERED
  RECEIVED
  CANCELLED
}

enum PromotionType {
  PERCENT
  FIXED
  PROMO_PRICE
  BULK
  BOGO
}

enum SessionStatus {
  OPEN
  CLOSED
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  registers      Register[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  batches        ProductBatch[]
  sales          Sale[]
  purchases      Purchase[]
  sessions       CashierSession[]
  returns        Return[]
  expenses       Expense[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  branchId     String?  @db.Uuid
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch   Branch?          @relation(fields: [branchId], references: [id])
  sessions CashierSession[]

  @@index([branchId, role])
}

model Register {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch   Branch           @relation(fields: [branchId], references: [id])
  sessions CashierSession[]

  @@unique([branchId, name])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  contact   String?
  phone     String?
  email     String?
  address   String?
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  purchases      Purchase[]
  payments       SupplierPayment[]
  supplierPrices SupplierPrice[]
}

model SupplierPayment {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @db.Uuid
  userId     String   @db.Uuid
  amount     Decimal  @db.Decimal(14, 2)
  note       String?
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, createdAt])
}

model SupplierPrice {
  supplierId String   @db.Uuid
  productId  String   @db.Uuid
  unitCost   Decimal  @db.Decimal(14, 2)
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@id([supplierId, productId])
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  sku           String   @unique
  name          String
  brand         String?
  manufacturer  String?
  categoryId    String?  @db.Uuid
  supplierId    String?  @db.Uuid
  unit          String   @default("pcs")
  packageSize   String?
  imageUrl      String?
  purchasePrice Decimal  @default(0) @db.Decimal(14, 2)
  taxRate       Decimal  @default(0) @db.Decimal(5, 2)
  minStock      Decimal  @default(0) @db.Decimal(14, 3)
  maxStock      Decimal? @db.Decimal(14, 3)
  tracksExpiry  Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  barcodes       Barcode[]
  prices         PriceHistory[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  batches        ProductBatch[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  promotions     Promotion[]
  supplierPrices SupplierPrice[]

  @@index([name])
  @@index([categoryId])
  @@index([isActive])
}

model Barcode {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  productId  String   @db.Uuid
  isPrimary  Boolean  @default(false)
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ExternalProductCache {
  barcode   String   @id
  data      Json
  fetchedAt DateTime @default(now())
}

model PriceHistory {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  oldPrice      Decimal? @db.Decimal(14, 2)
  newPrice      Decimal  @db.Decimal(14, 2)
  effectiveFrom DateTime
  userId        String   @db.Uuid
  reason        String?
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, effectiveFrom])
}

model StockLevel {
  productId String  @db.Uuid
  branchId  String  @db.Uuid
  quantity  Decimal @default(0) @db.Decimal(14, 3)

  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@id([productId, branchId])
  @@index([branchId])
}

model ProductBatch {
  id         String    @id @default(uuid()) @db.Uuid
  productId  String    @db.Uuid
  branchId   String    @db.Uuid
  batchNo    String
  expiryDate DateTime? @db.Date
  quantity   Decimal   @default(0) @db.Decimal(14, 3)
  createdAt  DateTime  @default(now())

  product   Product         @relation(fields: [productId], references: [id])
  branch    Branch          @relation(fields: [branchId], references: [id])
  movements StockMovement[]

  @@unique([productId, branchId, batchNo])
  @@index([branchId, expiryDate])
}

model StockMovement {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @db.Uuid
  branchId    String       @db.Uuid
  batchId     String?      @db.Uuid
  type        MovementType
  quantity    Decimal      @db.Decimal(14, 3)
  unitCost    Decimal?     @db.Decimal(14, 2)
  userId      String       @db.Uuid
  reference   String?
  referenceId String?      @db.Uuid
  notes       String?
  createdAt   DateTime     @default(now())

  product Product       @relation(fields: [productId], references: [id])
  branch  Branch        @relation(fields: [branchId], references: [id])
  batch   ProductBatch? @relation(fields: [batchId], references: [id])

  @@index([productId, branchId, createdAt])
  @@index([branchId, type, createdAt])
  @@index([referenceId])
}

model Purchase {
  id         String         @id @default(uuid()) @db.Uuid
  number     String         @unique
  supplierId String         @db.Uuid
  branchId   String         @db.Uuid
  status     PurchaseStatus
  total      Decimal        @default(0) @db.Decimal(14, 2)
  notes      String?
  createdById String        @db.Uuid
  createdAt  DateTime       @default(now())
  receivedAt DateTime?

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  branch   Branch         @relation(fields: [branchId], references: [id])
  items    PurchaseItem[]

  @@index([branchId, createdAt])
  @@index([supplierId])
}

model PurchaseItem {
  id               String    @id @default(uuid()) @db.Uuid
  purchaseId       String    @db.Uuid
  productId        String    @db.Uuid
  quantityOrdered  Decimal   @db.Decimal(14, 3)
  quantityReceived Decimal   @default(0) @db.Decimal(14, 3)
  unitCost         Decimal   @db.Decimal(14, 2)
  batchNo          String?
  expiryDate       DateTime? @db.Date

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  phone         String?  @unique
  email         String?
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales Sale[]

  @@index([name])
}

model Promotion {
  id         String        @id @default(uuid()) @db.Uuid
  name       String
  type       PromotionType
  value      Decimal       @default(0) @db.Decimal(14, 2)
  minQty     Decimal       @default(1) @db.Decimal(14, 3)
  buyQty     Int           @default(1)
  getQty     Int           @default(1)
  productId  String?       @db.Uuid
  startsAt   DateTime
  endsAt     DateTime?
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())

  product Product? @relation(fields: [productId], references: [id])

  @@index([isActive, startsAt, endsAt])
}

model CashierSession {
  id           String        @id @default(uuid()) @db.Uuid
  registerId   String        @db.Uuid
  branchId     String        @db.Uuid
  cashierId    String        @db.Uuid
  status       SessionStatus @default(OPEN)
  openingCash  Decimal       @db.Decimal(14, 2)
  expectedCash Decimal?      @db.Decimal(14, 2)
  actualCash   Decimal?      @db.Decimal(14, 2)
  difference   Decimal?      @db.Decimal(14, 2)
  notes        String?
  openedAt     DateTime      @default(now())
  closedAt     DateTime?

  register Register @relation(fields: [registerId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  cashier  User     @relation(fields: [cashierId], references: [id])
  sales    Sale[]
  returns  Return[]

  @@index([branchId, openedAt])
  @@index([cashierId, status])
}

model Sale {
  id          String     @id @default(uuid()) @db.Uuid
  clientId    String     @unique @db.Uuid
  receiptNo   String     @unique
  branchId    String     @db.Uuid
  sessionId   String     @db.Uuid
  cashierId   String     @db.Uuid
  customerId  String?    @db.Uuid
  status      SaleStatus @default(COMPLETED)
  subtotal    Decimal    @db.Decimal(14, 2)
  discountTotal Decimal  @default(0) @db.Decimal(14, 2)
  taxTotal    Decimal    @default(0) @db.Decimal(14, 2)
  total       Decimal    @db.Decimal(14, 2)
  changeGiven Decimal    @default(0) @db.Decimal(14, 2)
  offline     Boolean    @default(false)
  soldAt      DateTime   @default(now())
  voidedAt    DateTime?
  voidedById  String?    @db.Uuid
  voidReason  String?
  createdAt   DateTime   @default(now())

  branch   Branch         @relation(fields: [branchId], references: [id])
  session  CashierSession @relation(fields: [sessionId], references: [id])
  customer Customer?      @relation(fields: [customerId], references: [id])
  items    SaleItem[]
  payments Payment[]
  returns  Return[]

  @@index([branchId, soldAt])
  @@index([sessionId])
  @@index([cashierId, soldAt])
}

model SaleItem {
  id            String  @id @default(uuid()) @db.Uuid
  saleId        String  @db.Uuid
  productId     String  @db.Uuid
  name          String
  quantity      Decimal @db.Decimal(14, 3)
  returnedQty   Decimal @default(0) @db.Decimal(14, 3)
  unitPrice     Decimal @db.Decimal(14, 2)
  unitCost      Decimal @db.Decimal(14, 2)
  discount      Decimal @default(0) @db.Decimal(14, 2)
  taxRate       Decimal @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal @default(0) @db.Decimal(14, 2)
  lineTotal     Decimal @db.Decimal(14, 2)

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  saleId    String        @db.Uuid
  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2)
  reference String?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model Return {
  id           String        @id @default(uuid()) @db.Uuid
  number       String        @unique
  saleId       String        @db.Uuid
  branchId     String        @db.Uuid
  sessionId    String?       @db.Uuid
  userId       String        @db.Uuid
  approvedById String?       @db.Uuid
  method       PaymentMethod
  refundAmount Decimal       @db.Decimal(14, 2)
  reason       String
  createdAt    DateTime      @default(now())

  sale    Sale            @relation(fields: [saleId], references: [id])
  branch  Branch          @relation(fields: [branchId], references: [id])
  session CashierSession? @relation(fields: [sessionId], references: [id])
  items   ReturnItem[]

  @@index([saleId])
  @@index([branchId, createdAt])
}

model ReturnItem {
  id         String  @id @default(uuid()) @db.Uuid
  returnId   String  @db.Uuid
  saleItemId String  @db.Uuid
  quantity   Decimal @db.Decimal(14, 3)
  amount     Decimal @db.Decimal(14, 2)
  restock    Boolean @default(true)

  return   Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id])

  @@index([returnId])
}

model HeldSale {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  userId    String   @db.Uuid
  label     String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([branchId, userId])
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  userId      String   @db.Uuid
  category    String
  amount      Decimal  @db.Decimal(14, 2)
  description String?
  incurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, incurredAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  branchId  String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}
